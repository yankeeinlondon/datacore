{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "tabWidth": 4,
  "semi": true,
  "singleQuote": false,
  "printWidth": 120,
  "useTabs": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "ignorePatterns": ["docs/**", "features/**", "**/*.md", "**/*.api.md", "pnpm-lock.yaml", "**/build/**", "**/dist/**"],
  "overrides": [
    {
      "files": ["**/*.json", "**/*.jsonc", "**/*.yaml", "**/*.yml"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
