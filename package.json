{
  "name": "datacore-monorepo",
  "private": true,
  "description": "datacore-engine: a shared, headless query engine for Obsidian plus view plugins that consume it.",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=!@yankeeinlondon/datacore-docs build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware && eslint .",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/sync-plugin-manifests.mjs && pnpm install --lockfile-only",
    "manifests:check": "node scripts/sync-plugin-manifests.mjs --check",
    "docs:build": "pnpm --filter @yankeeinlondon/datacore-docs build",
    "docs:start": "pnpm --filter @yankeeinlondon/datacore-docs start"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/json": "2.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.5.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "tsdown": "0.23.7",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
