{
  "name": "datacore-monorepo",
  "private": true,
  "description": "datacore-engine: a shared, headless query engine for Obsidian plus view plugins that consume it.",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "0.78.0",
    "tsdown": "0.23.7",
    "typescript": "5.8.3",
    "vitest": "5.1.0"
  }
}
