{
  "name": "@yankeeinlondon/datacore-client",
  "version": "0.0.0",
  "description": "Client for datacore-engine: locate the shared engine from any Obsidian plugin, with typed access to its API.",
  "license": "MIT",
  "author": "Ken Snyder <ken@ken.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yankeeinlondon/datacore.git",
    "directory": "packages/client"
  },
  "keywords": [
    "obsidian",
    "datacore",
    "datacore-engine"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsdown && api-extractor run --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/luxon": "^2.4.0",
    "@yankeeinlondon/datacore-contract": "workspace:^"
  },
  "devDependencies": {
    "@yankeeinlondon/datacore-shared": "workspace:^",
    "jsdom": "31.0.0"
  }
}
