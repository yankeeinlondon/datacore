{
  "name": "@yankeeinlondon/datacore-contract",
  "version": "1.0.1",
  "description": "The datacore-engine API contract: interfaces, data shapes, registry protocol, and protocol constants.",
  "license": "MIT",
  "author": "Ken Snyder",
  "homepage": "https://github.com/yankeeinlondon/datacore/tree/master/packages/contract#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yankeeinlondon/datacore.git",
    "directory": "packages/contract"
  },
  "bugs": {
    "url": "https://github.com/yankeeinlondon/datacore/issues"
  },
  "keywords": [
    "obsidian",
    "obsidian-md",
    "obsidian-plugin",
    "datacore",
    "datacore-engine",
    "dataview",
    "query",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown && api-extractor run --local",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/luxon": "^2.4.0"
  }
}
