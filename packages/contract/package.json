{
  "name": "@yankeeinlondon/datacore-contract",
  "version": "0.0.0",
  "description": "The datacore-engine API contract: interfaces, data shapes, registry protocol, and protocol constants.",
  "license": "MIT",
  "author": "Ken Snyder <ken@ken.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yankeeinlondon/datacore.git",
    "directory": "packages/contract"
  },
  "keywords": [
    "obsidian",
    "datacore",
    "datacore-engine"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown && api-extractor run --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/luxon": "^2.4.0"
  }
}
