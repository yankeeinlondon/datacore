#!/usr/bin/env bash
# Install the built engine plugin into a vault (for trying it outside the test vault). Run `pnpm build` first.
# Usage: scripts/install-built <path-to-your-vault-root>
set -euo pipefail

PLUGIN_NAME="datacore-engine"
VAULT="${1:-}"

if [ -z "$VAULT" ]; then
    echo "Usage: scripts/install-built <path-to-your-vault-root>" >&2
    exit 1
fi

# Resolve the build output relative to this script, not the caller's working directory.
PACKAGE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUILD="$PACKAGE_DIR/build/plugin"
for file in main.js styles.css manifest.json; do
    if [ ! -f "$BUILD/$file" ]; then
        echo "Missing $BUILD/$file; run 'pnpm build' first." >&2
        exit 1
    fi
done

TARGET="$VAULT/.obsidian/plugins/$PLUGIN_NAME"
mkdir -p "$TARGET"
cp -f "$BUILD/main.js" "$BUILD/styles.css" "$BUILD/manifest.json" "$TARGET/"
echo "Installed $PLUGIN_NAME $(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$BUILD/manifest.json") to $TARGET"
